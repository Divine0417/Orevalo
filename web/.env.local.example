# Copy to .env.local and fill in from your Supabase project (Settings -> API).
# .env.local is gitignored — never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key for the admin panel. Bypasses row level security, so it must
# never be prefixed NEXT_PUBLIC_ and never be read from a client component.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enables double opt-in confirmation emails.
# Without it the app runs SINGLE opt-in and says so in the admin dashboard.
# Get a key at https://resend.com (free tier covers early volumes).
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=Orevalo <hello@orevalo.com>
# SCRAPER_ADMIN_EMAIL=team@orevalo.com
# SCRAPER_CRON_DRY_RUN=false

# Absolute base URL used in confirm/unsubscribe links.
# NEXT_PUBLIC_SITE_URL=https://orevalo.com
